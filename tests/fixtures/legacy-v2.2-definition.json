{
  "format": "arcaea-difficulty/2",
  "name": "Frequency and movement laboratory \u2014 uncalibrated",
  "sample_ms": 10,
  "arc_step_ms": 10,
  "frequency_window_ms": 500,
  "movement_window_ms": 500,
  "peak_min_ms": 20,
  "near_peak_ratio": 0.9,
  "arc_threshold": 0.25,
  "judgment_profile": "tight",
  "candidate_policy": "exclude",
  "parameters": {
    "tap_scale": 1.0,
    "tap_threshold": 0.0,
    "tap_power": 1.0,
    "arc_scale": 1.5,
    "arc_threshold_speed": 0.0,
    "arc_power": 1.2
  },
  "responses": {
    "tap": {
      "type": "expression",
      "expression": "tap_scale * max(0,v-tap_threshold)**tap_power"
    },
    "arc": {
      "type": "expression",
      "expression": "arc_scale * (max(0,v-arc_threshold_speed) + max(0,v-arc_threshold_speed)**arc_power)"
    }
  },
  "metrics": {
    "note": "max(frequency_mean,frequency_mode)",
    "Peak": "frequency_peak",
    "distance": "total_weight",
    "movement": "movement_peak",
    "Arc": "arc_weight"
  },
  "axes": {
    "x": "frequency",
    "y": "movement",
    "smoothing_ms": 10,
    "trail_ms": 1500
  }
}
